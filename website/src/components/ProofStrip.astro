---
const stats = [
  { value: '3+', label: 'clusters · 1 quorum', tag: 'multi-cluster' },
  { value: '11', label: 'CRDs · 0 Helm charts', tag: 'declarative' },
  { value: '100%', label: 'OIDC + mTLS by default', tag: 'secure' },
  { value: 'Apache', label: '2.0 · open source', tag: 'no lock-in' },
];
---

<section class="border-y border-border/40 bg-bg-raised/30">
  <div class="container-site grid grid-cols-2 gap-px md:grid-cols-4">
    {stats.map((s, i) => (
      <div class={`flex flex-col gap-1 py-8 ${i > 0 ? 'md:border-l border-border/40' : ''} ${i === 2 ? 'border-t md:border-t-0' : ''} ${i === 3 ? 'border-t md:border-t-0' : ''} ${i === 1 ? 'border-l md:border-l border-border/40' : ''}`}>
        <span class="font-display text-4xl text-fg">{s.value}</span>
        <span class="text-sm text-fg-muted">{s.label}</span>
        <span class="mt-1 font-mono text-[10px] uppercase tracking-wider text-fg-dim">{s.tag}</span>
      </div>
    ))}
  </div>
</section>
