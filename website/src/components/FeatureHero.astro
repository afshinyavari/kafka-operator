---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  meta?: string[];
}

const { eyebrow, title, lede, meta = [] } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border/40">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 left-1/2 h-[520px] w-[1000px] -translate-x-1/2 rounded-full bg-brand/[0.07] blur-[120px]"></div>
  </div>
  <div class="container-site py-20 md:py-28">
    <div class="mx-auto max-w-3xl">
      <a href="/" class="eyebrow inline-flex items-center gap-2 text-fg-muted hover:text-fg">
        <span aria-hidden="true">←</span> Features
      </a>
      <p class="eyebrow mt-6 text-brand">{eyebrow}</p>
      <h1 class="mt-3 font-display text-5xl leading-[1.05] tracking-tight md:text-6xl">{title}</h1>
      <p class="mt-6 text-lg text-fg-muted md:text-xl">{lede}</p>
      {meta.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-3 text-xs text-fg-muted">
          {meta.map((m) => (
            <li class="rounded-full border border-border bg-bg-raised px-3 py-1.5 font-mono">{m}</li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
