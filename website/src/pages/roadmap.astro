---
import Base from '../layouts/Base.astro';
import FeatureHero from '../components/FeatureHero.astro';
import Prose from '../components/Prose.astro';
import Callout from '../components/Callout.astro';
import CtaSection from '../components/CtaSection.astro';
import roadmap from '../data/roadmap.json';
import { site } from '../site.config';

const title = 'Roadmap';
const description = `Upcoming features for ${site.brand}: live migration from any Kafka cluster, tiered storage with Apache Iceberg (Aiven), and a visual Kafka Streams topology designer that builds on the shipped kafka-editor.`;

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${site.brand} roadmap`,
  description,
  numberOfItems: roadmap.length,
  itemListElement: roadmap.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: item.title,
      description: stripHtml(item.detail),
      url: `${site.url}/roadmap/#${item.slug}`,
      keywords: item.keywords.join(', '),
    },
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Roadmap', item: `${site.url}/roadmap/` },
  ],
};
---

<Base title={title} description={description} schema={[itemList, breadcrumbs]}>
  <FeatureHero
    eyebrow="Roadmap"
    title="What's coming next."
    lede="Three headline features in active design. Open development — if any of these is the difference between you adopting this operator or not, tell us and we'll prioritise. The shipped feature set is already production-grade; what follows here makes it strategic."
    meta={['3 features in design', 'open development', 'priorities user-driven']}
  />

  <section class="container-site py-12">
    <div class="mx-auto max-w-prose">
      <Callout tone="note" title="Honest about timelines">
        <p>
          We're not putting dates here because we don't want to ship a date we
          can't hit. If you need a specific feature by a specific quarter for
          a real evaluation, <a class="text-brand-bright underline" href={`mailto:${site.contactEmail}`}>email us</a> —
          design partners shape the order, and we'll be straight about what's
          tractable.
        </p>
      </Callout>
    </div>
  </section>

  {roadmap.map((item, i) => (
    <section id={item.slug} class={`container-site py-20 ${i % 2 === 1 ? 'bg-bg-raised/30' : ''} scroll-mt-20`}>
      <div class="mx-auto max-w-3xl">
        <div class="flex items-center gap-3">
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-brand-bright">
            {String(i + 1).padStart(2, '0')} · {item.eyebrow}
          </span>
          <span class="rounded-full border border-border-strong bg-bg-inset px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-fg-muted">
            Coming soon
          </span>
        </div>
        <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight md:text-5xl">{item.title}</h2>
        <p class="mt-4 text-xl text-fg-muted">{item.tagline}</p>
        <Prose>
          <p class="mt-8" set:html={item.detail} />
        </Prose>
        <div class="mt-6 flex flex-wrap gap-2">
          {item.keywords.slice(0, 4).map((kw) => (
            <span class="rounded-full border border-border bg-bg-inset px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-fg-muted">
              {kw}
            </span>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaSection />
</Base>
